{
    "name": "avathar/rankpoststyling",
    "type": "phpbb-extension",
    "description": "This extension adds a CSS rule option to user ranks, which can be used style posts of users with those ranks.",
    "homepage": "https://github.com/avandenberghe/RankPostStyling",
    "version": "2.0.0",
    "time": "2026-03-01",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "PayBas",
            "role": "Previous Developer"
        },
        {
            "name": "Sajaki",
            "email": "sajaki@avathar.be",
            "homepage": "https://www.avathar.be/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpbb/epv": "dev-master"
    },
    "extra": {
        "display-name": "Rank Post Styling",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "protocol": "https://",
            "host": "avathar.be",
            "directory": "/versioncheck",
            "filename": "rankpoststyling.json"
        }
    }
}
